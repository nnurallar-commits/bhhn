rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v7 tek ortak kasa: uygulama linkini açan cihazlar aynı belgeyi okur ve yazar.
    match /sharedApps/bhhn-main {
      allow read, write: if true;
    }

    // Bunun dışındaki bütün Firestore belgeleri kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
