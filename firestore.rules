rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }
    function isMember(workspaceId) {
      return signedIn() && request.auth.uid in get(workspacePath(workspaceId)).data.memberUids;
    }
    function isOwner(workspaceId) {
      return signedIn() && get(workspacePath(workspaceId)).data.ownerUid == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      // Yeni alanı yalnızca alan sahibi kendi UID'siyle oluşturabilir.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && request.resource.data.profiles.keys().hasOnly([request.auth.uid])
                    && request.resource.data.profiles[request.auth.uid].id == request.auth.uid;

      // Bir alanın içeriği yalnızca üyeler tarafından görülebilir.
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Normal alan ayarlarını yalnızca owner değiştirebilir.
      // Üye olmayan bir kullanıcının izin verilen tek güncellemesi, davet sonrası
      // yalnızca kendisini memberUids ve profiles alanlarına eklemesidir.
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (
          !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'profiles'])
          && request.resource.data.profiles.diff(resource.data.profiles).addedKeys().hasOnly([request.auth.uid])
          && request.resource.data.profiles.diff(resource.data.profiles).changedKeys().size() == 0
          && request.resource.data.profiles.diff(resource.data.profiles).removedKeys().size() == 0
          && request.resource.data.profiles[request.auth.uid].id == request.auth.uid
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{kind}/{docId} {
        allow read, create, update, delete: if isMember(workspaceId);
      }
    }

    // Davet kodu ayrı bir dizinde tutulur. Böylece kullanıcılar davet kodu ararken
    // diğer kullanıcıların workspace belgelerini okuyamaz.
    match /workspaceInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && getAfter(workspacePath(request.resource.data.workspaceId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
                    && get(workspacePath(resource.data.workspaceId)).data.ownerUid == request.auth.uid;
    }
  }
}
